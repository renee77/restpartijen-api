# Copy this file to .env (ignored by git) and fill in the values. See README, section Configuration.

# Required. The HMAC secret for the JWT tokens, at least 32 bytes. Without it the application stops (FTD §16.4, B-52).
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Required. The contact address Open Food Facts asks every app to send in its User-Agent (FTD §10.3, A5).
# Without it the application stops. Use your own or a project address; it is not stored in the source.
OFF_CONTACT_EMAIL=

# Optional. "memory" (default) keeps the H2 database in memory; "file" writes it to ./data/restpartijen (FTD GI-1, bijlage B).
# DB_MODE=file
