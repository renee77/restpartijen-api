# Shared editor settings; ktlint also reads its rules from this file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses two trailing spaces as a hard line break, so keep them.
[*.md]
trim_trailing_whitespace = false

# Windows batch files need CRLF; labels and goto can break with LF.
[*.{bat,cmd}]
end_of_line = crlf

[*.{kt,kts}]
indent_style = space
indent_size = 4
# The team works in IntelliJ, so ktlint follows the IntelliJ IDEA style, which matches the Kotlin coding conventions.
ktlint_code_style = intellij_idea
# The intellij_idea style has no line-length limit by default; 120 is the team's choice.
# IntelliJ also reads this value, so the IDE and ktlint wrap at the same width.
max_line_length = 120
